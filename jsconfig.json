{
    "compilerOptions": {
        "checkJs": true,
        "module": "commonjs",
        "target": "es2022",
        "lib": ["es2022"],
        "types": ["node", "vscode"],
        "strict": false,
        "noEmit": true,
        "maxNodeModuleJsDepth": 0,
        "skipLibCheck": true
    },
    "include": ["src/**/*.js"]
}
