{
    "name": "latex-colors",
    "displayName": "LaTeX Colors",
    "description": "Colors LaTeX source the way xcolor colors the PDF (\\textcolor, \\color, \\colorbox, and one-argument macros built on them or on soul and ulem), and highlights editorial marks ([[rewrite]], xxrephrasexx, ((note)), ....expand....) in LaTeX, Markdown and plain text.",
    "version": "0.7.0",
    "publisher": "local",
    "license": "MIT",
    "engines": {
        "vscode": "^1.145.0"
    },
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": "limited",
            "description": "The probe compile, which runs the document's preamble, is off in untrusted workspaces.",
            "restrictedConfigurations": [
                "latexColors.probe.enabled",
                "latexColors.probe.engine"
            ]
        }
    },
    "activationEvents": [
        "onLanguage:latex",
        "onLanguage:tex",
        "onLanguage:markdown",
        "onLanguage:plaintext",
        "onStartupFinished"
    ],
    "main": "./src/extension.js",
    "contributes": {
        "configuration": {
            "title": "LaTeX Colors",
            "properties": {
                "latexColors.colors.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Color LaTeX source as xcolor colors the PDF."
                },
                "latexColors.marks.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "Highlight editorial marks: [[rewrite]], xxrephrasexx, ((note)), ....expand....."
                },
                "latexColors.marks.patterns": {
                    "type": "array",
                    "default": [
                        {
                            "name": "rewrite",
                            "regex": "\\[\\[[\\s\\S]*?\\]\\]",
                            "color": "#ffa829"
                        },
                        {
                            "name": "rephrase",
                            "regex": "(?<![A-Za-z])x{2,}(?:(?:(?![^A-Za-z]x{2})[^\\n])*?x{2,}(?![A-Za-z])|[A-Za-z]*)",
                            "color": "#f93d53"
                        },
                        {
                            "name": "note",
                            "regex": "\\(\\([\\s\\S]*?\\)\\)",
                            "color": "#b97ad7"
                        },
                        {
                            "name": "expand",
                            "regex": "\\.{4,}(?:[^\\n]*?\\.{4,})?",
                            "color": "#88bd69"
                        }
                    ],
                    "markdownDescription": "Editorial marks: each a `name`, a JavaScript `regex` (matched across lines with `[\\s\\S]`), a `color`, and optionally a `background` (default: the color at 15% opacity) and a `fontStyle` (default `italic`). Replaces the built-in marks.",
                    "items": {
                        "type": "object",
                        "required": [
                            "name",
                            "regex",
                            "color"
                        ],
                        "properties": {
                            "name": {
                                "type": "string"
                            },
                            "regex": {
                                "type": "string"
                            },
                            "color": {
                                "type": "string"
                            },
                            "background": {
                                "type": "string"
                            },
                            "fontStyle": {
                                "type": "string",
                                "enum": [
                                    "italic",
                                    "normal",
                                    "oblique"
                                ]
                            }
                        }
                    }
                },
                "latexColors.marks.languages": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "default": [
                        "latex",
                        "tex",
                        "markdown",
                        "plaintext"
                    ],
                    "description": "Language identifiers in which editorial marks are highlighted."
                },
                "latexColors.liftDarkColors": {
                    "type": "boolean",
                    "default": true,
                    "description": "On dark themes, lighten colors too dark to read."
                },
                "latexColors.minLuminance": {
                    "type": "number",
                    "default": 0.35,
                    "minimum": 0,
                    "maximum": 1,
                    "description": "On dark themes, colors are lightened until their relative luminance reaches this value."
                },
                "latexColors.probe.enabled": {
                    "type": "boolean",
                    "default": true,
                    "description": "After each save, compile the preamble with a generated body (shell escape off, in a temporary directory) so LaTeX reports the exact color of each command and color expression. Runs only in trusted workspaces."
                },
                "latexColors.probe.engine": {
                    "type": "string",
                    "default": "",
                    "enum": [
                        "",
                        "pdflatex",
                        "lualatex",
                        "xelatex",
                        "latex",
                        "platex",
                        "uplatex"
                    ],
                    "enumDescriptions": [
                        "Automatic: as LaTeX Workshop would compile the root file, else a % !TEX program magic comment, else pdflatex.",
                        "",
                        "",
                        "",
                        "",
                        "",
                        ""
                    ],
                    "description": "TeX engine for the probe compile."
                },
                "latexColors.probe.timeout": {
                    "type": "number",
                    "default": 30,
                    "minimum": 1,
                    "description": "Seconds before a probe compile is stopped."
                }
            }
        },
        "commands": [
            {
                "command": "latexColors.toggleColors",
                "title": "Toggle Colors",
                "category": "LaTeX Colors"
            },
            {
                "command": "latexColors.toggleMarks",
                "title": "Toggle Editorial Marks",
                "category": "LaTeX Colors"
            },
            {
                "command": "latexColors.rescan",
                "title": "Rescan and Rerun the Probe",
                "category": "LaTeX Colors"
            },
            {
                "command": "latexColors.showOutput",
                "title": "Show Output",
                "category": "LaTeX Colors"
            }
        ]
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/brendanjohnharris/latex-colors"
    },
    "scripts": {
        "test": "node --test \"test/*.test.js\" \"test/unit/*.test.js\"",
        "test:update": "UPDATE=1 node --test \"test/*.test.js\" \"test/unit/*.test.js\"",
        "typecheck": "tsc --noEmit -p jsconfig.json",
        "package": "vsce package",
        "test:vscode": "vscode-test",
        "bench": "node scripts/bench.js"
    },
    "devDependencies": {
        "@types/node": "^22.0.0",
        "@types/vscode": "1.145.0",
        "@vscode/test-cli": "^0.0.15",
        "@vscode/test-electron": "^3.1.0",
        "@vscode/vsce": "4.1.1",
        "typescript": "~5.9.3"
    }
}
